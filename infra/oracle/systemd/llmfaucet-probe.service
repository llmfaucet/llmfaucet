[Unit]
Description=llmfaucet provider health probe
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/llmfaucet-probe
EnvironmentFile=-/opt/llmfaucet/.env
ExecStart=/usr/bin/node /opt/llmfaucet-probe/src/index.mjs
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
