# llmfaucet local/Cloudflare environment reference.
# Do not commit a populated .env file. Cloudflare Worker deployments use
# wrangler.toml bindings and GitHub Actions secrets instead.

NODE_ENV=production
PROVIDER_MODEL_SYNC_INTERVAL_MS=21600000
# Comma-separated exact HTTPS origins for newly registered providers.
PROVIDER_EGRESS_ALLOWLIST=

# Cloudflare account/resource identifiers. These are not secrets.
CF_ACCOUNT_ID=0d2359d43c21549125a1e76f9d6fdb8f
CF_KV_NAMESPACE_ID=9d5fca7879c445edba258aed07f3849f
CF_D1_DATABASE_ID=97eabec5-22a7-4115-9461-bdd9ba51abcc

# Operational cache keys used by Worker maintenance and catalog tooling.
CATALOG_KV_KEY=llmfaucet:catalog
HEALTH_KV_KEY=llmfaucet:health
BUDGET_HASH_SECRET=
IP_HASH_SECRET=
SESSION_HMAC_SECRET=
OAUTH_STATE_SECRET=
AI_HORDE_URL=https://aihorde.net/api/v2/generate/async
POLLINATIONS_URL=https://text.pollinations.ai/openai
LLM7_URL=https://api.llm7.io/v1/chat/completions
OPENCODE_ZEN_URL=https://opencode.ai/zen/v1/chat/completions
OVH_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1/chat/completions

# Optional catalog source. Leave empty to use the checked-in catalog.
CATALOG_URL=

# Optional GitHub identity/sponsor layer; keep blank until OAuth/webhook apps exist.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SESSION_SECRET=
GITHUB_SPONSORABLE_LOGIN=justinedevs
GITHUB_SPECIAL_SPONSORS=
PUBLIC_METRICS_INCLUDE_AGGREGATES=false
GITHUB_SUPPORTER_TIER_ID=
GITHUB_PRO_TIER_ID=
GITHUB_SPONSORS_WEBHOOK_SECRET=
GITHUB_SPONSOR_LOGIN=justinedevs
GITHUB_PUBLIC_READ_TOKEN=
GITHUB_PUBLIC_REPOSITORY=llmfaucet/llmfaucet
SDK_NPM_PACKAGE=@llmfaucet/sdk
CLI_NPM_PACKAGE=@llmfaucet/cli
ANONYMOUS_DAILY_LIMIT=20
REGISTERED_DAILY_LIMIT=50
SUPPORTER_DAILY_LIMIT=200
PRO_DAILY_LIMIT=500
PUBLIC_BASE_URL=
PUBLIC_FRONTEND_URL=
PUBLIC_WEB_ORIGINS=
ADMIN_GITHUB_LOGINS=replace-with-admin-logins

# Browser-visible Pages build variables. These are repository variables in
# GitHub Actions, not Worker secrets.
NEXT_PUBLIC_API_BASE_URL=https://api.llmfaucet.dev
NEXT_PUBLIC_PREVIEW_API_BASE_URL=https://<preview-worker-subdomain>.workers.dev
