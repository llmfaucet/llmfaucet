# llmfaucet local/VPS environment reference.
# Do not commit a populated .env file. Cloudflare Worker deployments use
# wrangler.toml bindings and GitHub Actions secrets instead.

NODE_ENV=production
PROBE_INTERVAL_MS=3600000

# Cloudflare account/resource identifiers. These are not secrets.
CF_ACCOUNT_ID=0d2359d43c21549125a1e76f9d6fdb8f
CF_KV_NAMESPACE_ID=9d5fca7879c445edba258aed07f3849f
CF_D1_DATABASE_ID=97eabec5-22a7-4115-9461-bdd9ba51abcc

# Required only by an external VPS probe writer. Use a scoped Cloudflare API
# token; never paste "Bearer ", quotes, or a Global API key here.
CF_API_TOKEN=

# Operational keys used by the probe writer.
CATALOG_KV_KEY=llmfaucet:catalog
HEALTH_KV_KEY=llmfaucet:health
BUDGET_HASH_SECRET=
IP_HASH_SECRET=
SESSION_HMAC_SECRET=
OAUTH_STATE_SECRET=
AI_HORDE_URL=https://aihorde.net/api/v2/generate/async

# Optional catalog source. Leave empty to use the checked-in catalog.
CATALOG_URL=

# Optional GitHub identity/sponsor layer; keep blank until OAuth/webhook apps exist.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SESSION_SECRET=
GITHUB_SPONSORABLE_LOGIN=justinedevs
GITHUB_SPECIAL_SPONSORS=
PUBLIC_METRICS_INCLUDE_AGGREGATES=false
GITHUB_SUPPORTER_TIER_ID=
GITHUB_PRO_TIER_ID=
GITHUB_SPONSORS_WEBHOOK_SECRET=
GITHUB_SPONSOR_LOGIN=justinedevs
ANONYMOUS_DAILY_LIMIT=20
REGISTERED_DAILY_LIMIT=50
SUPPORTER_DAILY_LIMIT=200
PRO_DAILY_LIMIT=500
PUBLIC_BASE_URL=
ADMIN_GITHUB_LOGINS=replace-with-admin-logins
