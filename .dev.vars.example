# Local Worker bindings. Keep real credentials in `.dev.vars`, never commit them.
ENVIRONMENT=development
CATALOG_URL=
BUDGET_HASH_SECRET=generate-a-long-random-value
IP_HASH_SECRET=generate-a-long-random-value
SESSION_HMAC_SECRET=generate-a-long-random-value
OAUTH_STATE_SECRET=generate-a-long-random-value
POLLINATIONS_URL=https://text.pollinations.ai/openai
LLM7_URL=https://api.llm7.io/v1/chat/completions
OPENCODE_ZEN_URL=https://opencode.ai/zen/v1/chat/completions
OVH_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1/chat/completions
AI_HORDE_URL=https://aihorde.net/api/v2/generate/async

# Optional local-only IDs/secrets for the VPS probe. Do not use a Global API key.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=
CF_D1_DATABASE_ID=

# Optional GitHub OAuth/Sponsors layer. Leave blank to keep account routes closed.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SESSION_SECRET=
GITHUB_SPONSORABLE_LOGIN=justinedevs
GITHUB_SPECIAL_SPONSORS=
PUBLIC_METRICS_INCLUDE_AGGREGATES=false
GITHUB_SUPPORTER_TIER_ID=
GITHUB_PRO_TIER_ID=
GITHUB_SPONSORS_WEBHOOK_SECRET=
GITHUB_SPONSOR_LOGIN=justinedevs
ANONYMOUS_DAILY_LIMIT=20
REGISTERED_DAILY_LIMIT=50
SUPPORTER_DAILY_LIMIT=200
PRO_DAILY_LIMIT=500
PUBLIC_BASE_URL=http://localhost:8787
PUBLIC_FRONTEND_URL=http://localhost:3000
PUBLIC_WEB_ORIGINS=http://localhost:3000,http://localhost:8787
ADMIN_GITHUB_LOGINS=JustineDevs
GITHUB_PUBLIC_REPOSITORY=llmfaucet/llmfaucet
GITHUB_PUBLIC_READ_TOKEN=
SDK_NPM_PACKAGE=
CLI_NPM_PACKAGE=
