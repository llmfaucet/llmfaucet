{
  "name": "@llmfaucet/cli",
  "version": "0.1.0",
  "description": "llmfaucet setup, diagnostics, and coding-agent configuration CLI.",
  "type": "module",
  "bin": {
    "llmfaucet": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/llmfaucet/llmfaucet.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "llmfaucet",
    "cli",
    "setup",
    "aider",
    "claude-code",
    "cline"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
